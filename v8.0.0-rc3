mkdir -p $HOME/.mantrachain/cosmovisor/upgrades/v8.0.0-rc3/bin
wget https://github.com/MANTRA-Chain/mantrachain/releases/download/v8.0.0-rc3/mantrachaind-8.0.0-rc3-linux-amd64.tar.gz
tar -xvf mantrachaind-8.0.0-rc3-linux-amd64.tar.gz
sudo mv mantrachaind $HOME/.mantrachain/cosmovisor/upgrades/v8.0.0-rc3/bin/
chmod +x $HOME/.mantrachain/cosmovisor/upgrades/v8.0.0-rc3/bin/mantrachaind
sudo ln -sfn $HOME/.mantrachain/cosmovisor/upgrades/v8.0.0-rc3 $HOME/.mantrachain/cosmovisor/current
sudo ln -sfn $HOME/.mantrachain/cosmovisor/current/bin/mantrachaind /usr/local/bin/mantrachaind

sudo systemctl restart mantrachaind
sudo journalctl -fu mantrachaind -o cat
